# Supabase Configuration
# Dapatkan kredensial ini di Dashboard Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# (Opsional) URL aplikasi untuk redirect Google OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pemindaian foto struk (server-side; jangan pakai prefix NEXT_PUBLIC_)
OPENAI_API_KEY=your-openai-api-key-here
# Opsional: gunakan model vision yang tersedia di akun Anda
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
